# Path to the SQLite database file, as seen by the backend process. Under
# docker compose this is a path inside the "velometr-data" named volume
# (mounted at /data), so it survives image rebuilds/redeploys regardless of
# this value - change it only if you also change the volume mount point in
# docker-compose.yml. Running the backend directly (not via compose), point
# it at any path you want persisted.
DATA_PATH=/data/velometr.db

# Shared passcode gating access to the app. No accounts, no registration -
# this is the only credential.
AUTH_PASSCODE=change-me

# Port the backend listens on when run directly, i.e. not via docker
# compose (optional, defaults to 8080).
PORT=8080

# Host port docker compose exposes the frontend (nginx) on (optional,
# defaults to 8080).
FRONTEND_PORT=8080
