# Path to the SQLite database file, as seen by the backend process. Under
# docker compose this is always a path inside the container's /data
# directory (see the backend service's `volumes:` in docker-compose.yml),
# which is what DATA_VOLUME below actually persists - change this only if
# you also change that mount point to match. Running the backend directly
# (not via compose), point it at any path you want persisted.
DATA_PATH=/data/velometr.db

# What backs the backend's /data directory under docker compose (optional).
# Left unset (default), it's a Docker-managed named volume - self-contained,
# survives image rebuilds/redeploys, but not directly browsable on the host.
# Set it to an absolute host directory to bind-mount that directory instead,
# so the SQLite file is a real file on the host at that path. Keep any host
# path you choose in this file only - it's machine-specific and .env is
# gitignored for that reason.
# DATA_VOLUME=/absolute/path/on/host

# Shared passcode gating access to the app. No accounts, no registration -
# this is the only credential.
AUTH_PASSCODE=change-me

# Port the backend listens on when run directly, i.e. not via docker
# compose (optional, defaults to 8080).
PORT=8080

# Host port docker compose exposes the frontend (nginx) on (optional,
# defaults to 8080).
FRONTEND_PORT=8080

# Frontend build variant (optional, defaults to "production"). "production"
# runs Kotlin/Wasm's dead-code-elimination and webpack minification - the
# deploy-ready bundle, but slow to build. Set to "development" locally to skip
# those optimization passes for a much faster `docker compose up --build`
# loop while iterating; never use "development" for a real deployment.
FRONTEND_BUILD_MODE=production
